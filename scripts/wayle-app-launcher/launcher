#!/bin/sh
set -eu

app_file="${XDG_CONFIG_HOME:-$HOME/.config}/ags/wayle-launcher/app.tsx"
if [ ! -r "$app_file" ]; then
  printf '%s\n' "wayle-app-launcher: AGS entry point is missing: $app_file" >&2
  exit 1
fi

if /usr/bin/ags toggle launcher --instance wayle-app-launcher >/dev/null 2>&1; then
  exit 0
fi

exec /usr/bin/ags run "$app_file" --gtk 4
