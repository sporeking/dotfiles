#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

readonly STEP_K=100
readonly MIN_TEMPERATURE_K=1000
readonly MAX_TEMPERATURE_K=20000

die() {
    printf 'wayle-hyprsunset-temperature: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: %s {up|down|status|set TEMPERATURE_K}\n' "$0" >&2
    exit 2
}

require_runtime() {
    [[ -n "${XDG_RUNTIME_DIR:-}" ]] || die 'XDG_RUNTIME_DIR is not set'
    [[ -d "$XDG_RUNTIME_DIR" ]] || die "runtime directory does not exist: $XDG_RUNTIME_DIR"
    command -v hyprctl >/dev/null 2>&1 || die 'hyprctl is not available in PATH'
    command -v flock >/dev/null 2>&1 || die 'flock is not available in PATH'
}

query_temperature() {
    local response

    if ! response="$(hyprctl hyprsunset temperature 2>&1)"; then
        response="${response//$'\n'/ }"
        die "failed to query current temperature: $response"
    fi

    response="${response//$'\r'/}"
    [[ "$response" =~ ^[0-9]+$ ]] || die "invalid temperature returned by hyprsunset: $response"
    printf '%s\n' "$response"
}

validate_temperature() {
    local value="$1"

    [[ "$value" =~ ^[0-9]+$ ]] || die "temperature must be an integer in Kelvin: $value"
    (( value >= MIN_TEMPERATURE_K && value <= MAX_TEMPERATURE_K )) || \
        die "temperature must be between ${MIN_TEMPERATURE_K}K and ${MAX_TEMPERATURE_K}K: ${value}K"
}

set_temperature() {
    local target="$1"
    local response

    validate_temperature "$target"
    if ! response="$(hyprctl hyprsunset temperature "$target" 2>&1)"; then
        response="${response//$'\n'/ }"
        die "failed to set temperature to ${target}K: $response"
    fi

    response="${response//$'\r'/}"
    [[ "$response" == 'ok' ]] || die "unexpected response while setting temperature: $response"
}

[[ $# -ge 1 && $# -le 2 ]] || usage
require_runtime

exec 9>"$XDG_RUNTIME_DIR/wayle-hyprsunset-temperature.lock" || \
    die "cannot open runtime lock in $XDG_RUNTIME_DIR"
flock -x 9 || die 'cannot acquire runtime lock'

case "$1" in
    status)
        [[ $# -eq 1 ]] || usage
        query_temperature
        ;;
    set)
        [[ $# -eq 2 ]] || usage
        set_temperature "$2"
        ;;
    up|down)
        [[ $# -eq 1 ]] || usage
        current="$(query_temperature)"
        validate_temperature "$current"

        if [[ "$1" == 'up' ]]; then
            target=$((current + STEP_K))
        else
            target=$((current - STEP_K))
        fi

        set_temperature "$target"
        ;;
    *)
        usage
        ;;
esac
