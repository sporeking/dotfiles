#!/usr/bin/env python3
"""Dedicated native Pi floating window control (Hyprland 0.55+ Lua API)."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time
import tomllib

ROOT = Path(__file__).resolve().parent.parent
APP_ID = "nvim-quick-ask"
WORKSPACE = "special:quick-ask"


def runtime_dir() -> Path:
    override = os.environ.get("QUICK_ASK_RUNTIME_DIR")
    base = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/quick-ask-{os.getuid()}"))
    path = (Path(override) if override else base / APP_ID).expanduser().absolute()
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.stat().st_uid != os.getuid():
        raise RuntimeError("Pi runtime directory is not owned by this user")
    path.chmod(0o700)
    return path


def run(args: list[str], *, timeout: float = 8) -> str:
    result = subprocess.run(args, text=True, capture_output=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError((result.stderr or result.stdout).strip() or f"{args[0]} failed")
    return result.stdout.strip()


def hypr_json(command: str):
    return json.loads(run(["hyprctl", "-j", command]))


def lua(code: str) -> None:
    result = run(["hyprctl", "eval", code])
    if result != "ok":
        raise RuntimeError(result or "Hyprland returned no result")


def clients() -> list[dict]:
    return [c for c in hypr_json("clients") if c.get("class") == APP_ID]


def visible() -> bool:
    return any(m.get("specialWorkspace", {}).get("name") == WORKSPACE
               for m in hypr_json("monitors"))


def control_socket() -> Path:
    return runtime_dir() / "kitty.sock"


def remote(*args: str, timeout: float = 3) -> str:
    return run(["kitty", "@", "--to", "unix:" + str(control_socket()),
                "--use-password", "never", *args], timeout=timeout)


def configure_rule() -> None:
    # Keep the established app-id and workspace; ordinary Kitty windows never match.
    lua('if not _G.__nvim_quick_ask_rule then '
        '_G.__nvim_quick_ask_rule = hl.window_rule({'
        'name="nvim-quick-ask",match={class="^nvim-quick-ask$"},'
        'float=true,workspace="special:quick-ask silent",'
        'size={900,600},center=true}) end')


def launch_settings() -> tuple[str, Path, Path]:
    """Read only launcher settings. Pi owns all model, extension and auth settings."""
    path = Path(os.environ.get("QUICK_ASK_CONFIG") or "~/.config/nvim-quick-ask/config.toml").expanduser()
    data = {}
    if path.exists():
        with path.open("rb") as stream:
            data = tomllib.load(stream)
    pi, agent = data.get("pi", {}), data.get("agent", {})
    if not isinstance(pi, dict) or not isinstance(agent, dict):
        raise ValueError("pi and agent settings must be TOML tables")
    command = pi.get("command", "pi")
    workspace = agent.get("workspace", "~/agent-workspace")
    for name, value in (("pi.command", command), ("agent.workspace", workspace)):
        if not isinstance(value, str) or not value.strip() or "\x00" in value:
            raise ValueError(f"{name} must be a nonempty string")
    command = os.path.expanduser(command)
    if os.sep in command:
        command = str(Path(command).absolute())
    db = Path(os.environ.get("QUICK_ASK_DB") or "~/.local/share/nvim-quick-ask/history.sqlite3").expanduser().absolute()
    return command, Path(workspace).expanduser().absolute(), db.parent / "sessions"


def kitty_command(command: str, sessions: Path) -> list[str]:
    # The user's fonts/colors remain intact. Ignore only startup_session, which
    # would otherwise replace our explicit child command, and close confirmations.
    return ["kitty", "--class", APP_ID, "--title", "Pi", "--session", "none",
            "--listen-on", "unix:" + str(control_socket()),
            "--override", "allow_remote_control=socket-only",
            "--override", "confirm_os_window_close=0",
            command, "--tui-mode", "fullscreen", "--session-dir", str(sessions),
            "--continue", "--extension", str(ROOT / "extensions" / "vim-navigation.ts")]


def process_identity(pid: int) -> tuple[int, str] | None:
    """Linux parent PID and birth tick; never signal a recycled process ID."""
    try:
        path = Path(f"/proc/{pid}/stat")
        if path.stat().st_uid != os.getuid():
            return None
        fields = path.read_text().rpartition(")")[2].split()
        if fields[0] == "Z":
            return None
        return int(fields[1]), fields[19]
    except (OSError, ValueError, IndexError):
        return None


def remember_children(owned: dict[int, str], root_pid: int | None = None) -> None:
    """Capture this window's descendants, including detached command groups."""
    if root_pid is not None:
        identity = process_identity(root_pid)
        if identity:
            owned[root_pid] = identity[1]
    table = {}
    for path in Path("/proc").glob("[0-9]*/stat"):
        pid = int(path.parent.name)
        identity = process_identity(pid)
        if identity:
            table[pid] = identity
    parents = {pid for pid, birth in owned.items() if pid in table and table[pid][1] == birth}
    while True:
        children = {pid for pid, (parent, birth) in table.items() if parent in parents and pid not in parents}
        if not children:
            break
        for pid in children:
            owned[pid] = table[pid][1]
        parents.update(children)


def alive(owned: dict[int, str]) -> bool:
    return any((identity := process_identity(pid)) and identity[1] == birth for pid, birth in owned.items())


def signal_owned(owned: dict[int, str], signum: int) -> None:
    for pid, birth in owned.items():
        identity = process_identity(pid)
        if identity and identity[1] == birth and pid != os.getpid():
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass


def clean_children(owned: dict[int, str]) -> None:
    for signum in (signal.SIGTERM, signal.SIGKILL):
        if not alive(owned):
            return
        remember_children(owned)
        signal_owned(owned, signum)
        deadline = time.monotonic() + 1
        while alive(owned) and time.monotonic() < deadline:
            time.sleep(0.05)
    if alive(owned):
        raise RuntimeError("Pi window's owned processes did not finish shutting down")


def clear_stale_socket() -> None:
    path = control_socket()
    if not path.exists():
        return
    if path.is_symlink() or not path.is_socket():
        raise RuntimeError("Pi control path is not a dedicated Unix socket")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
        probe.settimeout(0.5)
        try:
            probe.connect(str(path))
        except (ConnectionRefusedError, FileNotFoundError):
            path.unlink(missing_ok=True)  # Verified private runtime's dead kitty.sock.
        else:
            raise RuntimeError("Pi control socket is live but its window is missing")


def ensure_started() -> None:
    existing = clients()
    if existing:
        if len(existing) != 1:
            raise RuntimeError("Multiple Pi windows found; close duplicates first")
        return
    command, workspace, sessions = launch_settings()
    for program in (command, "kitty", "hyprctl"):
        if shutil.which(program) is None:
            raise RuntimeError(f"Required program not found: {program}")
    if not (ROOT / "extensions" / "vim-navigation.ts").is_file():
        raise RuntimeError("Pi navigation extension is missing")
    workspace.mkdir(mode=0o700, parents=True, exist_ok=True)
    sessions.mkdir(mode=0o700, parents=True, exist_ok=True)
    configure_rule()
    clear_stale_socket()
    runtime = runtime_dir()
    with (runtime / "window.log").open("a") as log:
        proc = subprocess.Popen(kitty_command(command, sessions), env=os.environ.copy(), cwd=workspace,
                                stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                start_new_session=True, umask=0o077)
    owned = {}
    try:
        remember_children(owned, proc.pid)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            remember_children(owned)
            if proc.poll() is not None:
                raise RuntimeError(f"Kitty exited during startup; inspect {runtime / 'window.log'}")
            if clients() and control_socket().exists():
                try:
                    if json.loads(remote("ls")):
                        return  # Mapped, hidden by the rule, and remotely controllable.
                except (RuntimeError, ValueError, subprocess.TimeoutExpired):
                    pass
            time.sleep(0.1)
        raise RuntimeError(f"Pi startup timed out; inspect {runtime / 'window.log'}")
    except BaseException:
        remember_children(owned)
        clean_children(owned)
        proc.wait(timeout=2)
        raise


def hide() -> None:
    # No agent notification/cancellation: visibility belongs to the compositor.
    if clients() and visible():
        lua('hl.dispatch(hl.dsp.workspace.toggle_special("quick-ask"))')


def window_geometry(monitor: dict) -> tuple[int, int, int, int]:
    """Center within the monitor's logical work area, including rotated panels."""
    width, height = monitor["width"], monitor["height"]
    if monitor.get("transform", 0) % 2:
        width, height = height, width
    scale = monitor.get("scale", 1)
    left, top, right, bottom = monitor.get("reserved", [0, 0, 0, 0])
    available_width = width / scale - left - right
    available_height = height / scale - top - bottom
    width = max(1, min(900, int(available_width) - 48))
    height = max(1, min(600, int(available_height) - 48))
    x = round(monitor["x"] + left + (available_width - width) / 2)
    y = round(monitor["y"] + top + (available_height - height) / 2)
    return x, y, width, height


def place_window() -> None:
    windows = clients()
    if len(windows) != 1:
        raise RuntimeError("Expected one Pi window while positioning")
    window = windows[0]
    monitor = next((m for m in hypr_json("monitors") if m["id"] == window["monitor"]), None)
    if monitor is None:
        raise RuntimeError("Pi monitor is unavailable; try showing it again")
    x, y, width, height = window_geometry(monitor)
    selector = json.dumps("address:" + window["address"])
    lua(f'hl.dispatch(hl.dsp.window.resize({{window={selector},x={width},y={height},relative=false}})); '
        f'hl.dispatch(hl.dsp.window.move({{window={selector},x={x},y={y},relative=false}}))')


def show() -> None:
    ensure_started()
    if not visible():
        lua('hl.dispatch(hl.dsp.workspace.toggle_special("quick-ask"))')
    place_window()
    lua('hl.dispatch(hl.dsp.focus({window="class:^nvim-quick-ask$"}))')


def stop() -> None:
    windows = clients()
    if not windows:
        return
    if len(windows) != 1:
        raise RuntimeError("Multiple Pi windows found; close duplicates first")
    owned = {}
    remember_children(owned, windows[0].get("pid"))
    # Native Pi handles SIGTERM with its session_shutdown lifecycle. This works
    # independently of editor mode or queued input.
    try:
        remote("signal-child", "--match", "all", "SIGTERM")
    except (RuntimeError, OSError, subprocess.TimeoutExpired):
        pass
    deadline = time.monotonic() + 4
    while clients() and time.monotonic() < deadline:
        remember_children(owned)
        time.sleep(0.05)
    if clients():
        try:
            remote("close-window", "--match", "all")
        except (RuntimeError, OSError, subprocess.TimeoutExpired):
            pass
    clean_children(owned)
    deadline = time.monotonic() + 2
    while clients():
        if time.monotonic() >= deadline:
            raise RuntimeError("Pi window did not finish shutting down")
        time.sleep(0.05)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", default="toggle",
                        choices=["start", "toggle", "show", "hide", "status", "stop", "config"])
    args = parser.parse_args()
    if args.action == "config":
        invocation = shlex.join([sys.executable, str(ROOT / "bin" / "quick-ask")])
        print('-- Add this to your Hyprland Lua config (or dofile the project fragment):')
        print(f'hl.bind("ALT + A", hl.dsp.exec_cmd({json.dumps(invocation + " toggle")}))')
        print('hl.on("hyprland.start", function()')
        print(f'  hl.exec_cmd({json.dumps(invocation + " start")})')
        print('end)')
        return 0
    with (runtime_dir() / "control.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.action == "status":
            print(json.dumps({"running": bool(clients()), "visible": visible(),
                              "socket": str(control_socket())}, ensure_ascii=False))
        elif args.action == "start":
            ensure_started()
        elif args.action == "show":
            show()
        elif args.action == "hide":
            hide()
        elif args.action == "toggle":
            hide() if visible() else show()
        elif args.action == "stop":
            stop()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f"quick-ask: {error}", file=sys.stderr)
        raise SystemExit(1)
